# Copy to local.env (gitignored) and fill in; tools/*.sh read it. Variables already set in the environment win.
MV83_TEAM_ID="${MV83_TEAM_ID:-}"            # Apple development team ID (tools/build_ios.sh)
MV83_DEVICE="${MV83_DEVICE:-}"              # iPhone UDID for tools/push_data.sh
SIM="${SIM:-booted}"                        # Simulator UDID for tools/simtest.sh
PEER="${PEER:-}"                            # Tailscale machine that tools/build_mac.sh --send Taildrops to
MV83_SERVER_AGENT="${MV83_SERVER_AGENT:-}"  # launchd label of your Cosmic server (restarted by tools/convert_data.sh)
MV83_OTA_PUBLISH="${MV83_OTA_PUBLISH:-}"    # script run as: <script> <ipa> --title --note --commit --keep (tools/build_ios.sh --publish)
